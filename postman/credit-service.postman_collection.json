{
  "info": {
    "_postman_id": "2c6e5b2f-1bb5-4d6b-9b53-credit-service",
    "name": "NTT Bootcamp - Credit Service via API Gateway",
    "description": "Collection para probar credit-service a traves de api-gateway. Ejecutar primero Auth / Login - Admin.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "customer_id",
      "value": "69e984c3ea77252c2fd48d7c"
    },
    {
      "key": "credit_id",
      "value": "REPLACE_WITH_CREDIT_ID"
    },
    {
      "key": "amount",
      "value": "100.00"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso', function () { pm.response.to.have.status(200); });",
                  "const response = pm.response.json();",
                  "pm.collectionVariables.set('access_token', response.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/auth-service/auth/login",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "auth-service",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Credits",
      "item": [
        {
          "name": "Create Loan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Prestamo creado', function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "if (response.id) pm.collectionVariables.set('credit_id', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"creditLimit\": 5000.00,\n  \"interestRate\": 12.50,\n  \"dueDate\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/credit-service/api/v1/credits/loan",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "credit-service",
                "api",
                "v1",
                "credits",
                "loan"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Credit Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Tarjeta de credito creada', function () { pm.response.to.have.status(201); });",
                  "const response = pm.response.json();",
                  "if (response.id) pm.collectionVariables.set('credit_id', response.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customer_id}}\",\n  \"creditLimit\": 3000.00,\n  \"interestRate\": 35.00,\n  \"dueDate\": \"2026-12-31\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/credit-service/api/v1/credits/credit-card",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "credit-service",
                "api",
                "v1",
                "credits",
                "credit-card"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Consume Credit",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{amount}},\n  \"externalReference\": \"postman-consume\"\n}"
            },
            "url": {
              "raw": "{{gateway_url}}/credit-service/api/v1/credits/{{credit_id}}/consume",
              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "credit-service",
                "api",
                "v1",
                "credits",
                "{{credit_id}}",
                "consume"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Pay Credit",
          "request": {
            "method": "POST",
            "header": [
