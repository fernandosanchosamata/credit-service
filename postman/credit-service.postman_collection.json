              "host": [
                "{{gateway_url}}"
              ],
              "path": [
                "credit-service",
                "api",
                "v1",
                "credits",
                "customer",
                "{{customer_id}}",
                "has-active-credit-card"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
